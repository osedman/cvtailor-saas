# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose client-side

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Course repository sync ───────────────────────────────────
CRON_SECRET=replace-with-a-long-random-value
# COURSE_SOURCES_ENABLED=0                 # Emergency kill switch; enabled by default
# MICROSOFT_LEARN_ENABLED=0                # Disable Microsoft Learn; enabled by default
# MICROSOFT_LEARN_MAX_RECORDS=2000
# YOUTUBE_COURSES_ENABLED=1                # Requires the API key below
# YOUTUBE_API_KEY=
# YOUTUBE_COURSE_CHANNEL_IDS=              # Comma-separated vetted channel IDs
# YOUTUBE_COURSE_QUERIES=                   # Optional comma-separated skill searches
# COURSE_SOURCE_REGION=GB

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...             # Use sk_test_... for development
STRIPE_PUBLISHABLE_KEY=pk_live_...        # Exposed client-side (safe)
STRIPE_PRO_PRICE_ID=price_...            # Price ID from your Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...          # From: stripe listen --forward-to localhost:3000/api/stripe/webhook

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # Legacy; prefer APP_URL below
NEXT_PUBLIC_APP_URL=http://localhost:3000    # Product origin (prod: https://app.gettailr.com)
NEXT_PUBLIC_MARKETING_URL=https://www.gettailr.com  # Marketing site (Framer/Webflow)
# DOMAIN_SPLIT_ENABLED=true                  # Set in Vercel AFTER DNS for app + www is live
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.gettailr.com  # Optional override; production defaults to this
# See docs/DOMAINS.md

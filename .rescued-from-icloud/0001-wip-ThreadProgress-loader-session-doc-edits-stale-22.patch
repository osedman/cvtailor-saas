diff --git a/components/cv-tailor/thread-progress.tsx b/components/cv-tailor/thread-progress.tsx
new file mode 100644
index 0000000..2c8fe55
--- /dev/null
+++ b/components/cv-tailor/thread-progress.tsx
@@ -0,0 +1,132 @@
+"use client"
+
+import { useEffect, useState } from "react"
+
+const STEPS = [
+  "Analysing job requirements…",
+  "Matching your experience…",
+  "Rewriting bullet points…",
+  "Checking ATS compatibility…",
+  "Finalising your CV…",
+]
+
+/* A loose stitching curve — same motif as the Career Path journey line. */
+const THREAD_PATH = "M8,40 C 90,40 130,14 210,14 S 330,44 410,36 S 560,12 612,16"
+
+function usePrefersReducedMotion() {
+  const [reduced, setReduced] = useState(false)
+  useEffect(() => {
+    const mq = window.matchMedia("(prefers-reduced-motion: reduce)")
+    setReduced(mq.matches)
+    const onChange = (e: MediaQueryListEvent) => setReduced(e.matches)
+    mq.addEventListener("change", onChange)
+    return () => mq.removeEventListener("change", onChange)
+  }, [])
+  return reduced
+}
+
+interface ThreadProgressProps {
+  currentStep: number // 0-based index of the active step
+}
+
+/**
+ * Loading indicator for the tailor run: a coral thread stitches across a
+ * dashed guide path, one segment per stage, with a needle-dot riding the
+ * tip and stage copy crossfading beneath. Replaces the stacked checklist
+ * (progress-steps.tsx) per the motion design draft.
+ *
+ * The draw is pure CSS: the thread animates `stroke-dashoffset` and the
+ * needle animates `offset-distance` along the same path, sharing one
+ * duration/easing token so they stay in lockstep with no per-frame JS.
+ */
+export function ThreadProgress({ currentStep }: ThreadProgressProps) {
+  const reduced = usePrefersReducedMotion()
+
+  // Start fully undrawn so the first segment animates in after mount. A
+  // short timeout (not rAF, which stalls in occluded tabs) lets the
+  // undrawn state paint first so the browser runs the transition.
+  const [mounted, setMounted] = useState(false)
+  useEffect(() => {
+    const t = setTimeout(() => setMounted(true), 50)
+    return () => clearTimeout(t)
+  }, [])
+
+  const step = Math.min(Math.max(currentStep, 0), STEPS.length - 1)
+  const frac = mounted ? (step + 1) / STEPS.length : 0
+
+  // Crossfade the stage copy when the step advances.
+  const [shownStep, setShownStep] = useState(0)
+  const [fading, setFading] = useState(false)
+  useEffect(() => {
+    if (step === shownStep) return
+    if (reduced) {
+      setShownStep(step)
+      return
+    }
+    setFading(true)
+    const t = setTimeout(() => {
+      setShownStep(step)
+      setFading(false)
+    }, 180)
+    return () => clearTimeout(t)
+  }, [step, shownStep, reduced])
+
+  const drawTransition = reduced
+    ? "none"
+    : "stroke-dashoffset var(--motion-draw) var(--ease-brand)"
+  const rideTransition = reduced
+    ? "none"
+    : "offset-distance var(--motion-draw) var(--ease-brand)"
+
+  return (
+    <div className="w-full max-w-md mx-auto mt-3" role="status" aria-live="polite">
+      <svg
+        viewBox="0 0 620 56"
+        preserveAspectRatio="none"
+        aria-hidden="true"
+        className="block w-full h-12 overflow-visible"
+      >
+        <path
+          d={THREAD_PATH}
+          fill="none"
+          stroke="#ddd5c6"
+          strokeWidth={1}
+          strokeDasharray="3 5"
+        />
+        <path
+          d={THREAD_PATH}
+          fill="none"
+          stroke="#dc4f33"
+          strokeWidth={2.5}
+          strokeLinecap="round"
+          pathLength={1}
+          strokeDasharray={1}
+          style={{ strokeDashoffset: 1 - frac, transition: drawTransition }}
+        />
+        {/* Needle-dot rides the tip of the thread via CSS motion path. */}
+        <circle
+          r={4}
+          fill="#dc4f33"
+          style={{
+            offsetPath: `path("${THREAD_PATH}")`,
+            offsetDistance: `${frac * 100}%`,
+            offsetRotate: "0deg",
+            transition: rideTransition,
+          }}
+        />
+      </svg>
+      <div className="flex items-baseline justify-between mt-1.5 px-0.5">
+        <span
+          className={`text-[13px] font-semibold text-[#1e1813] transition-opacity duration-200 ${
+            fading ? "opacity-0" : "opacity-100"
+          }`}
+        >
+          {STEPS[shownStep]}
+        </span>
+        <span className="font-mono text-[11px] text-[#a09884] tabular-nums">
+          {shownStep + 1} / {STEPS.length}
+        </span>
+      </div>
+    </div>
+  )
+}

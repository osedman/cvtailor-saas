{
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "functions": {
    "app/api/tailor/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/path-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/course-sync",
      "schedule": "0 3 * * 0"
    }
  ]
}
{
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "regions": [
    "fra1"
  ],
  "functions": {
    "app/api/tailor/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/agency/cron",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 9 * * 0,1"
    }
  ]
}

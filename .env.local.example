# Supabase — get these from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Weekly course repository sync
CRON_SECRET=replace-with-a-long-random-value
# YOUTUBE_API_KEY=                       # Optional; Microsoft Learn + curated seed need no key
# YOUTUBE_COURSE_CHANNEL_IDS=            # Comma-separated vetted channel IDs
